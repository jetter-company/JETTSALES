# Firebase (Console > Configurações do projeto > Seus apps > Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini. No Google AI Studio a plataforma injeta GEMINI_API_KEY automaticamente;
# fora dele, informe VITE_GEMINI_API_KEY. Sem chave o briefing usa o texto determinístico.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
